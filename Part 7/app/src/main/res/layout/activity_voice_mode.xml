<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voiceRoot" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/voiceHeader" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <Button android:id="@+id/backVoice" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:minWidth="48dp" android:text="@string/plasma_back"
            android:textColor="@color/plasma_ice" android:backgroundTint="@color/plasma_surface" android:textAllCaps="false" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/plasma_title"
                android:textColor="@color/plasma_white" android:textSize="20sp" android:letterSpacing="0.14" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/plasma_subtitle"
                android:textColor="@color/plasma_muted_text" android:textSize="11sp" android:letterSpacing="0.12" />
        </LinearLayout>
        <Button android:id="@+id/voiceSettings" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:minWidth="48dp" android:text="@string/plasma_settings" android:maxWidth="104dp"
            android:textColor="@color/plasma_ice" android:backgroundTint="@color/plasma_surface" android:textAllCaps="false" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/voiceScroll" android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true" android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/voiceHeader" app:layout_constraintBottom_toTopOf="@id/voiceControls"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal" android:paddingBottom="16dp">
            <com.jarvis.assistant.ui.directives.VortexOrbView android:id="@+id/voiceOrb"
                android:layout_width="match_parent" android:layout_height="320dp" android:importantForAccessibility="noHideDescendants" />
            <TextView android:id="@+id/voiceStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:paddingHorizontal="24dp" android:text="@string/plasma_idle"
                android:textColor="@color/plasma_white" android:textSize="24sp" android:fontFamily="sans-serif-light"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/voiceReason" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:paddingHorizontal="24dp" android:paddingVertical="12dp"
                android:textColor="@color/plasma_muted_text" android:textSize="14sp" />
            <Button android:id="@+id/permissionSettings" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/plasma_permissions_settings" android:textAllCaps="false"
                android:visibility="gone" android:textColor="@color/plasma_ice" android:backgroundTint="@color/plasma_surface" />
            <Button android:id="@+id/startVoice" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/plasma_start" android:textAllCaps="false"
                android:textColor="@color/plasma_background" android:backgroundTint="@color/plasma_cyan" />
            <Button android:id="@+id/orbAppearance" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/plasma_style" android:textAllCaps="false"
                android:textColor="@color/plasma_ice" android:backgroundTint="@color/plasma_surface" />
            <Button android:id="@+id/toggleTranscript" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/plasma_show_transcript" android:textAllCaps="false"
                android:textColor="@color/plasma_muted_text" android:backgroundTint="@color/plasma_surface" />
            <LinearLayout android:id="@+id/transcriptPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_margin="20dp" android:padding="20dp" android:orientation="vertical"
                android:background="@color/plasma_surface" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/plasma_you"
                    android:textColor="@color/plasma_ice" android:textSize="12sp" />
                <TextView android:id="@+id/userTranscript" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingVertical="8dp" android:text="@string/plasma_transcript_empty" android:textIsSelectable="true"
                    android:textColor="@color/plasma_white" android:textSize="16sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/plasma_title"
                    android:textColor="@color/plasma_ice" android:textSize="12sp" />
                <TextView android:id="@+id/assistantTranscript" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingVertical="8dp" android:textIsSelectable="true" android:textColor="@color/plasma_white" android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/voiceControls" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp" android:background="@color/plasma_background"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout style="?android:attr/buttonBarStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/muteVoice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="56dp" android:text="@string/plasma_mute" android:textAllCaps="false"
                android:textColor="@color/plasma_ice" android:backgroundTint="@color/plasma_surface" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/interruptVoice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="56dp" android:text="@string/plasma_interrupt" android:textAllCaps="false"
                android:textColor="@color/plasma_ice" android:backgroundTint="@color/plasma_surface" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/endVoice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="56dp" android:text="@string/plasma_end" android:textAllCaps="false"
                android:textColor="@color/plasma_warning" android:backgroundTint="@color/plasma_surface" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/plasma_background_hint"
            android:textColor="@color/plasma_muted_text" android:gravity="center" android:textSize="12sp" android:paddingTop="8dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
