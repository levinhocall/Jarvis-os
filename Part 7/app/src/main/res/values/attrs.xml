<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Central Theme Tokens -->
    <attr name="themeBg" format="color|reference" />
    <attr name="themeSurface" format="color|reference" />
    <attr name="themeCardBg" format="color|reference" />
    <attr name="themeCardBorder" format="color|reference" />
    <attr name="themeTextPrimary" format="color|reference" />
    <attr name="themeTextSecondary" format="color|reference" />
    <attr name="themeTextMuted" format="color|reference" />
    <attr name="themeAccent1" format="color|reference" />
    <attr name="themeAccent2" format="color|reference" />
    <attr name="themeAccent3" format="color|reference" />
    <attr name="themeAccent" format="color|reference" />
    <attr name="themeAccentLight" format="color|reference" />
    <attr name="themeDockBg" format="color|reference" />
    <attr name="themeDockBorder" format="color|reference" />
    <attr name="themeChipBg" format="color|reference" />
    <attr name="themeInputBg" format="color|reference" />

    <!-- Liquid Glass Specular & Gradient Tokens -->
    <attr name="themeCardGlassStart" format="color|reference" />
    <attr name="themeCardGlassEnd" format="color|reference" />
    <attr name="themeDockGlassStart" format="color|reference" />
    <attr name="themeDockGlassEnd" format="color|reference" />
    <attr name="themeGlassSpecular" format="color|reference" />
    <attr name="themeGlowBlob1" format="reference" />
    <attr name="themeGlowBlob2" format="reference" />
    <attr name="themeGlowBlob3" format="reference" />

    <!-- LIA 3D Theme Attributes -->
    <attr name="liaBackground" format="color|reference" />
    <attr name="liaGradientTop" format="color|reference" />
    <attr name="liaSurface" format="color|reference" />
    <attr name="liaSurfaceRaised" format="color|reference" />
    <attr name="liaAccent" format="color|reference" />
    <attr name="liaAccentSecondary" format="color|reference" />
    <attr name="liaTextPrimary" format="color|reference" />
    <attr name="liaTextSecondary" format="color|reference" />
    <attr name="liaLotus" format="color|reference" />
    <attr name="liaLagoon" format="color|reference" />
    <attr name="liaRimLight" format="color|reference" />
    <attr name="liaDepthShadow" format="color|reference" />

    <!-- GlassCardView Attributes -->
    <declare-styleable name="GlassCardView">
        <attr name="glassCornerRadius" format="dimension" />
        <attr name="glassSurfaceColor" format="color" />
        <attr name="glassBorderColor" format="color" />
        <attr name="glassRimLightColor" format="color" />
        <attr name="glassBorderWidth" format="dimension" />
        <attr name="glassElevation" format="dimension" />
    </declare-styleable>

    <!-- PrimaryPillButton Attributes -->
    <declare-styleable name="PrimaryPillButton">
        <attr name="pillText" format="string" />
        <attr name="pillTextColor" format="color" />
        <attr name="pillStartColor" format="color" />
        <attr name="pillEndColor" format="color" />
        <attr name="pillIcon" format="reference" />
        <attr name="pillHaptic" format="boolean" />
    </declare-styleable>

    <!-- GlassInputBar Attributes -->
    <declare-styleable name="GlassInputBar">
        <attr name="inputHint" format="string" />
        <attr name="inputActionText" format="string" />
    </declare-styleable>
</resources>
